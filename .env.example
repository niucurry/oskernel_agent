# 查重引擎环境变量模板。复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，请勿提交真实密钥。

# --- GitLab（src.ingest 数据获取） ---
# GitLab Personal Access Token（read_api / read_repository 权限即可）
GITLAB_TOKEN=
# GitLab 实例地址（自建实例填私有域名，公有云保持默认）
GITLAB_URL=https://gitlab.com

# --- LLM 分析与语义复核（OpenAI 兼容 API：DeepSeek / Qwen 等） ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- run_batch.py 主/备用凭据（仅写在本地 .env，禁止提交真实值） ---
# 批处理会把当前槽位同步到上面的 LLM_API_KEY；备用值必须与主值不同。
BATCH_PRIMARY_LLM_API_KEY=
BATCH_FALLBACK_LLM_API_KEY=
# 默认关闭费时且不能作为评分依据的 AI 代码概率统计；确需研究时才设为 1。
BATCH_ENABLE_AI_DETECT=0
# 当届章程规定的最低提交次数；未知时留空，系统不会用自定门槛替代章程。
FINALS_MIN_COMMITS=

# --- Qdrant 向量库（src.embed，对应 docker-compose 服务） ---
QDRANT_URL=http://localhost:6333
