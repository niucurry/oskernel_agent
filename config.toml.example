[api]
# API 密钥与 OpenAI 兼容接入点（阿里云百炼）。复制本文件为 config.toml 后填入真实 key。
# 换 key 三件套：本文件 [api].key、.env 的 LLM_API_KEY、再重跑 python setup_opencode.py
key      = "sk-你的密钥"
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

[data]
repos_dir    = "./data/historical_repos"
metadata_dir = "./data/metadata"
cache_dir    = "./data/cache"   # 持久化符号索引 / FTS5 数据库（按仓库 hash 分文件）
reports_dir  = "./data/output"  # 四份正式报告统一输出到 data/output/<作品编号>/
reference_db_dir = "./reference_db"  # 参考 OS 代码指纹；缺失或损坏时自动重建
reference_sources_config = "./config/reference_sources.yaml"
reference_sources_dir = "./data/reference_sources"  # 自动拉取的固定版本源码缓存

[target]
# 可选：填写后 python agent.py 不带参数时使用此仓库；留空则要求命令行传入 --repo-id / --repo-path / --url
repo_id = ""

[engine]
rust_analyzer_timeout = 120   # 路径A 等待索引完成的最长秒数
clangd_timeout        = 60    # 路径B 等待索引完成的最长秒数
max_call_depth        = 3     # get_call_chain 默认展开层数
max_steps             = 30    # MCP server 每会话最大探索类工具调用步数（预算控制）
skip_dirs = ["vendor", "third_party", "target"]  # 路径C 跳过的目录
