{
  "$schema": "https://opencode.ai/config.json",

  "model": "deepseek/deepseek-chat",

  "provider": {
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      }
    }
  },

  "agent": {
    "os-kernel-analyzer": {
      "model": "deepseek/deepseek-chat",

      "system": "[此字段由 setup_opencode.py 写入：包含五层系统提示词（角色 + 仓库结构 + 工作流 + 硬性约束 + 输出格式）+ 可视化输出规范]",

      "permission": {
        "bash":  { "type": "deny" },
        "edit":  { "type": "deny" },
        "write": { "type": "deny" }
      }
    }
  },

  "mcp": {
    "os-kernel-tools": {
      "type": "local",
      "enabled": true,
      "command": [
        "/abs/path/to/.venv/bin/python",
        "/abs/path/to/mcp_server.py",
        "--max-steps", "200"
      ]
    }
  }
}
